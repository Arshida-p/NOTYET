# ==========================================
# NOTYET - Environment Configuration Template
# ==========================================
# Copy this file to .env for local development:
#   cp .env.example .env (Linux/macOS)
#   copy .env.example .env (Windows)

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Secret Key for Session Signing & Flash Messages
# In production, generate a secure random string (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Server Host & Port (Optional)
HOST=127.0.0.1
PORT=5000
